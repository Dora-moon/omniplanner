rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /mascots/{uid}/{fileName} {
      allow read: if true; // sprite URLs are rendered in <img> tags client-side
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|gif)');
    }
  }
}
